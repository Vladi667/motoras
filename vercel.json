{
  "cleanUrls": false,
  "rewrites": [],
  "redirects": [],
  "headers": [
    {
      "source": "/catalog-micro.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/catalog.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/catalog-lite.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/supplier-feed.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=600" }]
    },
    {
      "source": "/supplier-feed-globiz.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=600" }]
    },
    {
      "source": "/supplier-margins.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=120" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }]
    },
    {
      "source": "/product-sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ],
  "routes": [
    { "src": "^/(catalog|catalog-lite|catalog-micro)\\.json$", "status": 404, "dest": "/404.html" },
    { "src": "^/supplier-feed(?:-globiz)?\\.xml$", "status": 404, "dest": "/404.html" },
    { "src": "/api/webhook", "dest": "/api/orders" },
    { "src": "/api/admin/([^/]+)", "dest": "/api/admin/[action]?action=$1" },
    { "src": "/api/auth/([^/]+)", "dest": "/api/auth/[action]?action=$1" },
    { "src": "/piese-auto", "dest": "/api/products?render=category&cat=piese" },
    { "src": "/detailing", "dest": "/api/products?render=category&cat=detailing" },
    { "src": "/baterii", "dest": "/api/products?render=category&cat=baterii" },
    { "src": "/filtre", "dest": "/api/products?render=category&cat=filtre" },
    { "src": "/prelate", "dest": "/api/products?render=category&cat=prelate" },
    { "src": "/huse-prelate", "dest": "/api/products?render=category&cat=huse-prelate" },
    { "src": "/accesorii", "dest": "/api/products?render=category&cat=accesorii" },
    { "src": "/piese-auto-online", "dest": "/piese-auto-online.html" },
    { "src": "/piese-auto-bucuresti", "dest": "/piese-auto-bucuresti.html" },
    { "src": "/magazin-piese-auto-romania", "dest": "/magazin-piese-auto-romania.html" },
    { "src": "/piese-auto-livrare-nationala", "dest": "/piese-auto-livrare-nationala.html" },
    { "src": "/piese-auto-ieftine", "dest": "/piese-auto-ieftine.html" },
    { "src": "/cumpara-piese-auto-online", "dest": "/cumpara-piese-auto-online.html" },
    { "src": "/piese-auto-dupa-marca-si-model", "dest": "/piese-auto-dupa-marca-si-model.html" },
    { "src": "/verificare-compatibilitate-piese-auto", "dest": "/verificare-compatibilitate-piese-auto.html" },
    { "src": "/piese-auto-dupa-cod-oem", "dest": "/piese-auto-dupa-cod-oem.html" },
    { "src": "/piese-auto-dacia-logan", "dest": "/piese-auto-dacia-logan.html" },
    { "src": "/piese-auto-volkswagen-golf", "dest": "/piese-auto-volkswagen-golf.html" },
    { "src": "/piese-auto-bmw-seria-3", "dest": "/piese-auto-bmw-seria-3.html" },
    { "src": "/piese-auto-audi-a4", "dest": "/piese-auto-audi-a4.html" },
    { "src": "/piese-auto-skoda-octavia", "dest": "/piese-auto-skoda-octavia.html" },
    { "src": "/piese-auto-ford-focus", "dest": "/piese-auto-ford-focus.html" },
    { "src": "/piese-auto-opel-astra", "dest": "/piese-auto-opel-astra.html" },
    { "src": "/piese-auto-renault-clio", "dest": "/piese-auto-renault-clio.html" },
    { "src": "/harta-pagini-piese-auto", "dest": "/harta-pagini-piese-auto.html" },
    { "src": "/piese-auto-sector-2", "dest": "/piese-auto-sector-2.html" },
    { "src": "/piese-auto-sector-3", "dest": "/piese-auto-sector-3.html" },
    { "src": "/piese-auto-sector-4", "dest": "/piese-auto-sector-4.html" },
    { "src": "/livrare-piese-auto-bucuresti", "dest": "/livrare-piese-auto-bucuresti.html" },
    { "src": "/product-sitemap.xml", "dest": "/api/product-sitemap" },
    { "src": "/google-merchant-feed.xml", "dest": "/api/product-sitemap?type=merchant" },
    { "src": "^/product\\.html$", "dest": "/api/products?render=product" },
    { "src": "^/category\\.html$", "dest": "/api/products?render=category" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ],
  "functions": {
    "api/products/index.js": { "includeFiles": "{product,category}.html" }
  }
}
